# Copy this file to .streamlit/secrets.toml and fill it in.
# NEVER commit secrets.toml (it's in .gitignore).
# Without this file the app uses a simple name box instead of Google login.
#
# Get client_id and client_secret from Google Cloud Console:
#   APIs & Services > Credentials > Create OAuth client ID > Web application
#   Authorized redirect URI: http://localhost:8501/oauth2callback

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "any-long-random-string"
client_id = "xxxx.apps.googleusercontent.com"
client_secret = "xxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
